{
  "expo": {
    "name": "befit",
    "slug": "befit",
    "description": "A Product By OneRed",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/applogo.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#1A1735"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pfndesign.befit",
      "buildNumber": "1",
      "infoPlist": {
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/applogo.png",
        "backgroundColor": "#1A1735"
      },
      "package": "com.pfndesign.befit",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "apiBaseUrl": "https://testapp.bestronger.es/api"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      "expo-image",
      [
        "expo-notifications",
        {
          "color": "#1A1735"
        }
      ],
      [
        "react-native-share",
        {
          "ios": ["instagram-stories", "instagram"],
          "android": ["com.instagram.android"]
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Permite a BeFit guardar la imagen de tu resumen de entrenamiento en tu galería.",
          "savePhotosPermission": "Permite a BeFit guardar la imagen de tu resumen de entrenamiento en tu galería."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite a BeFit acceder a tus fotos para que puedas añadir una imagen a tus publicaciones.",
          "cameraPermission": "Permite a BeFit usar la cámara para que puedas añadir una foto a tus publicaciones."
        }
      ]
    ]
  }
}
